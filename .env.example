# Evolution API Configuration (Required)
EVOLUTION_HOST=http://localhost:8080
EVOLUTION_API_KEY=your-api-key-here
EVOLUTION_INSTANCE_NAME=my-whatsapp-instance

# Permission Tier (Optional)
# Options: read, send, admin
# Default: admin
PERMISSIONS_TIER=admin

# Whitelist Configuration (Optional)
# Set to 'false' to disable whitelist restrictions
WHITELIST_ENABLED=true

# Comma-separated list of whitelisted phone numbers (E.164 format)
# Example: +5491112345678,+5491187654321
WHITELIST_PHONES=

# Comma-separated list of whitelisted group JIDs
# Example: 123456789@g.us,987654321@g.us
WHITELIST_GROUPS=

# Block unknown senders (Optional)
# If true, messages from numbers not in whitelist will be blocked
# Default: true
WHITELIST_BLOCK_UNKNOWN=true

# Webhook Configuration (Optional)
# Port for the webhook HTTP server
WEBHOOK_PORT=3000

# Webhook endpoint path
WEBHOOK_PATH=/webhook

# Token for webhook authentication
# Minimum 8 characters
WEBHOOK_TOKEN=your-webhook-token-here
