{
  "name": "@jskirk/mcp-whatsapp-evo",
  "version": "1.0.0",
  "description": "MCP server for WhatsApp integration using evolution2-api-sdk. Connect AI agents to WhatsApp with permission controls and whitelist validation.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "mcp-whatsapp-evo": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node scripts/add-shebang.js",
    "watch": "tsc --watch",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "whatsapp",
    "evolution-api",
    "ai-agent",
    "modelcontextprotocol",
    "chatbot",
    "messaging"
  ],
  "author": "Jorge Solano Kirk",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/jskfox/mcp-whatsapp-evo.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "evolution2-api-sdk": "1.0.0",
    "zod": "3.25.76",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "typescript": "5.9.3",
    "vitest": "2.1.9",
    "eslint": "9.39.4",
    "@typescript-eslint/eslint-plugin": "8.58.1",
    "@typescript-eslint/parser": "8.58.1"
  },
  "files": [
    "dist",
    "config.example.yaml"
  ]
}
